---
import BrandBadge from '../BrandBadge.astro';
import { getUi } from '../../lib/i18n/ui.ts';
interface Props {
  locale: string;
}
const { locale } = Astro.props;
const ui = await getUi(locale);
const a = ui.home.about;
const stats = [
  { num: a.stat1Num, label: a.stat1Label },
  { num: a.stat2Num, label: a.stat2Label },
  { num: a.stat3Num, label: a.stat3Label },
];
---

<section class="site-section about" id="about">
  <div class="shell about-grid">
    <div class="about-copy" data-reveal>
      <span class="eyebrow">
        <span class="dot"></span>
        {a.eyebrow}
      </span>
      <h2>
        {a.titleLead} <span class="highlight">{a.titleHighlight}</span>{' '}
        {a.titleTrail}
      </h2>
      <p>{a.body1}</p>
      <p>{a.body2}</p>
    </div>
    <aside class="about-card" data-reveal data-reveal-delay="0.1">
      <BrandBadge size={64} />
      <p class="about-signoff">Teacher Thomas</p>
      <ul class="about-stats">
        {stats.map((stat) => (
          <li>
            <span class="stat-num">{stat.num}</span>
            <span class="stat-label">{stat.label}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<style>
  .about {
    border-block-start: var(--border-width) solid var(--color-border);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .about-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }
  .about-copy h2 {
    margin: 0;
    font-size: var(--font-size-heading);
  }
  .about-copy p {
    margin: 0;
    color: var(--color-muted);
    max-inline-size: 48ch;
  }
  .about-card {
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }
  .about-signoff {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: 1.2rem;
  }
  .about-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    margin: var(--space-sm) 0 0;
    padding: 0;
    list-style: none;
    inline-size: 100%;
  }
  .about-stats li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-block-start: var(--space-sm);
    border-block-start: 2px solid var(--color-accent);
  }
  .stat-num {
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: 1.6rem;
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
