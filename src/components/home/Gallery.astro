---
import { getUi } from '../../lib/i18n/ui.ts';
interface Props {
  locale: string;
}
const { locale } = Astro.props;
const ui = await getUi(locale);
const g = ui.home.gallery;
const tiles = ['a', 'b', 'c', 'd', 'e', 'f'];
---

<section class="site-section gallery" id="gallery">
  <div class="shell">
    <div class="section-head" data-reveal>
      <span class="eyebrow">
        <span class="dot"></span>
        {g.eyebrow}
      </span>
      <h2>{g.title}</h2>
      <p class="section-intro">{g.intro}</p>
    </div>
    <ul class="gallery-grid">
      {tiles.map((tile, index) => (
        <li class:list={['gallery-tile', `tile-${tile}`]} data-reveal>
          <span class="tile-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="6" width="18" height="14" rx="2" />
              <path d="M8 6 9.2 3.8A1 1 0 0 1 10.1 3.3h3.8a1 1 0 0 1 .9.5L16 6" />
              <circle cx="12" cy="13" r="3.2" />
            </svg>
          </span>
          <span class="tile-label">
            {g.placeholder} {index + 1}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .gallery {
    background: var(--color-surface);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 11rem;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gallery-tile {
    position: relative;
    border-radius: var(--radius-md);
    border: var(--border-width) dashed var(--color-border);
    background:
      linear-gradient(0deg, var(--color-grid) 1px, transparent 1px) 0 0 / 100%
        22px,
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px) 0 0 / 22px
        100%,
      var(--color-card);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    color: var(--color-muted);
    overflow: hidden;
  }
  .tile-a,
  .tile-f {
    grid-column: span 2;
  }
  .tile-icon {
    inline-size: 2.4rem;
    block-size: 2.4rem;
    border-radius: 0.7rem;
    background: var(--color-accent-soft);
    color: var(--color-text);
    display: grid;
    place-items: center;
  }
  .tile-icon svg {
    inline-size: 1.3rem;
    block-size: 1.3rem;
  }
  .tile-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (max-width: 760px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 9rem;
    }
    .tile-a,
    .tile-f {
      grid-column: span 2;
    }
  }
  @media (max-width: 460px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
    .tile-a,
    .tile-f {
      grid-column: span 1;
    }
  }
</style>
