---
import { getUi } from '../../lib/i18n/ui.ts';
interface Props {
  locale: string;
}
const { locale } = Astro.props;
const ui = await getUi(locale);
const s = ui.home.subjects;
const subjects = [
  { name: s.chemName, level: s.chemLevel, body: s.chemBody, icon: 'flask' },
  { name: s.physName, level: s.physLevel, body: s.physBody, icon: 'atom' },
  { name: s.mathName, level: s.mathLevel, body: s.mathBody, icon: 'function' },
  { name: s.sciName, level: s.sciLevel, body: s.sciBody, icon: 'orbit' },
  { name: s.sejName, level: s.sejLevel, body: s.sejBody, icon: 'book' },
  { name: s.bmName, level: s.bmLevel, body: s.bmBody, icon: 'quote' },
];
---

<section class="site-section subjects" id="subjects">
  <div class="shell">
    <div class="section-head" data-reveal>
      <span class="eyebrow">
        <span class="dot"></span>
        {s.eyebrow}
      </span>
      <h2>
        {s.titleLead} <span class="highlight">{s.titleHighlight}</span>{' '}
        {s.titleTrail}
      </h2>
      <p class="section-intro">{s.intro}</p>
    </div>
    <ul class="subject-grid" data-reveal>
      {subjects.map((subject) => (
        <li class="subject-card">
          <span class="subject-mark" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              {subject.icon === 'flask' && (
                <>
                  <path d="M9 3v6l-5 9a2 2 0 0 0 1.8 3h12.4A2 2 0 0 0 20 18l-5-9V3" />
                  <path d="M8 3h8M7.5 14h9" />
                </>
              )}
              {subject.icon === 'atom' && (
                <>
                  <circle cx="12" cy="12" r="2.2" />
                  <ellipse cx="12" cy="12" rx="10" ry="4.5" />
                  <ellipse
                    cx="12"
                    cy="12"
                    rx="10"
                    ry="4.5"
                    transform="rotate(60 12 12)"
                  />
                  <ellipse
                    cx="12"
                    cy="12"
                    rx="10"
                    ry="4.5"
                    transform="rotate(120 12 12)"
                  />
                </>
              )}
              {subject.icon === 'function' && (
                <>
                  <path d="M4 6h16M4 12h16M4 18h10" />
                  <circle cx="18.5" cy="18" r="2.2" />
                </>
              )}
              {subject.icon === 'orbit' && (
                <>
                  <path d="M12 3a9 9 0 1 0 9 9" />
                  <path d="M12 3v9l6 3" />
                </>
              )}
              {subject.icon === 'book' && (
                <>
                  <path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z" />
                  <path d="M18 3v16" />
                </>
              )}
              {subject.icon === 'quote' && (
                <>
                  <path d="M4 7h11M8 4v3M6 7c0 5 3 8 7 9M11 7c0 4-2 7-6 9" />
                  <path d="M14 20l3.5-8 3.5 8M15.2 17h4.6" />
                </>
              )}
            </svg>
          </span>
          <h3>{subject.name}</h3>
          <p class="subject-level">{subject.level}</p>
          <p class="subject-body">{subject.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .subject-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .subject-card {
    background: var(--color-card);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.4rem 1.4rem;
    box-shadow: var(--shadow-card);
    transition:
      transform 0.45s var(--ease),
      box-shadow 0.45s var(--ease);
  }
  .subject-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }
  .subject-mark {
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 0.85rem;
    background: var(--color-accent-soft);
    color: var(--color-text);
    display: grid;
    place-items: center;
    margin-block-end: 1.1rem;
  }
  .subject-mark svg {
    inline-size: 1.4rem;
    block-size: 1.4rem;
  }
  .subject-card h3 {
    margin: 0;
    font-size: var(--font-size-subheading);
  }
  .subject-level {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0.45rem 0 0.7rem;
  }
  .subject-body {
    margin: 0;
    font-size: var(--font-size-small);
    color: var(--color-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .subject-card {
      transition: none;
    }
  }
  @media (max-width: 860px) {
    .subject-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .subject-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
