---
import { getUi } from '../../lib/i18n/ui.ts';
interface Props {
  locale: string;
}
const { locale } = Astro.props;
const ui = await getUi(locale);
const s = ui.home.subjects;
const tiers = [
  {
    name: s.lowerName,
    level: s.lowerLevel,
    subjects: s.lowerSubjects,
    body: s.lowerBody,
  },
  {
    name: s.upperName,
    level: s.upperLevel,
    subjects: s.upperSubjects,
    body: s.upperBody,
  },
  {
    name: s.igcseName,
    level: s.igcseLevel,
    subjects: s.igcseSubjects,
    body: s.igcseBody,
  },
];
const chips = (value: string) => value.split('·').map((item) => item.trim());
---

<section class="site-section subjects" id="subjects">
  <div class="shell">
    <div class="section-head" data-reveal>
      <span class="eyebrow">
        <span class="dot"></span>
        {s.eyebrow}
      </span>
      <h2>
        {s.titleLead} <span class="highlight">{s.titleHighlight}</span>{' '}
        {s.titleTrail}
      </h2>
      <p class="section-intro">{s.intro}</p>
    </div>
    <ul class="tier-grid">
      {tiers.map((tier) => (
        <li class="tier-card" data-reveal>
          <div class="tier-head">
            <h3>{tier.name}</h3>
            <p class="tier-level">{tier.level}</p>
          </div>
          <ul class="tier-subjects">
            {chips(tier.subjects).map((subject) => (
              <li>{subject}</li>
            ))}
          </ul>
          <p class="tier-body">{tier.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tier-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tier-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    background: var(--color-card);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.6rem 1.5rem;
    box-shadow: var(--shadow-card);
    transition:
      transform 0.45s var(--ease),
      box-shadow 0.45s var(--ease);
  }
  .tier-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }
  .tier-head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .tier-card h3 {
    margin: 0;
    font-size: var(--font-size-subheading);
  }
  .tier-level {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .tier-subjects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0.2rem 0 0.4rem;
    list-style: none;
    border-block-start: var(--border-width) solid var(--color-border);
    padding-block-start: var(--space-sm);
  }
  .tier-subjects li {
    font-size: 0.78rem;
    font-weight: var(--weight-medium);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-text);
  }
  .tier-body {
    margin: auto 0 0;
    font-size: var(--font-size-small);
    color: var(--color-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .tier-card {
      transition: none;
    }
  }
  @media (max-width: 860px) {
    .tier-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
