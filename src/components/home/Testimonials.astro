---
import { getUi } from '../../lib/i18n/ui.ts';
interface Props {
  locale: string;
}
const { locale } = Astro.props;
const ui = await getUi(locale);
const t = ui.home.testimonials;
const items = [
  { quote: t.t1Quote, name: t.t1Name, meta: t.t1Meta },
  { quote: t.t2Quote, name: t.t2Name, meta: t.t2Meta },
  { quote: t.t3Quote, name: t.t3Name, meta: t.t3Meta },
];
---

<section class="site-section testimonials" id="testimonials">
  <div class="shell">
    <div class="section-head" data-reveal>
      <span class="eyebrow">
        <span class="dot"></span>
        {t.eyebrow}
      </span>
      <h2>{t.title}</h2>
      <p class="section-intro">{t.intro}</p>
      <p class="sample-note">{t.note}</p>
    </div>
    <ul class="testimonial-grid">
      {items.map((item) => (
        <li class="testimonial-card" data-reveal>
          <span class="quote-mark" aria-hidden="true">
            “
          </span>
          <blockquote>{item.quote}</blockquote>
          <div class="testimonial-by">
            <span class="by-name">{item.name}</span>
            <span class="by-meta">{item.meta}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .testimonials {
    background: var(--color-surface);
    border-block-start: var(--border-width) solid var(--color-border);
  }
  .sample-note {
    align-self: start;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: var(--color-card);
    border: var(--border-width) dashed var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.7rem;
  }
  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .testimonial-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    background: var(--color-card);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.6rem 1.5rem;
    box-shadow: var(--shadow-card);
  }
  .quote-mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.6rem;
    line-height: 0.6;
    color: var(--color-accent);
  }
  .testimonial-card blockquote {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }
  .testimonial-by {
    margin-block-start: auto;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-block-start: var(--space-sm);
    border-block-start: var(--border-width) solid var(--color-border);
  }
  .by-name {
    font-weight: var(--weight-heading);
    font-size: 0.9rem;
  }
  .by-meta {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  @media (max-width: 860px) {
    .testimonial-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
