---
import { getUi } from '../../lib/i18n/ui.ts';
interface Props {
  locale: string;
}
const { locale } = Astro.props;
const ui = await getUi(locale);
const sc = ui.home.schedule;
const rows = [
  {
    days: sc.block1Days,
    time: sc.block1Time,
    mode: sc.block1Mode,
    status: sc.block1Status,
    open: true,
  },
  {
    days: sc.block2Days,
    time: sc.block2Time,
    mode: sc.block2Mode,
    status: sc.block2Status,
    open: false,
  },
  {
    days: sc.block3Days,
    time: sc.block3Time,
    mode: sc.block3Mode,
    status: sc.block3Status,
    open: true,
  },
];
---

<section class="site-section schedule" id="schedule">
  <div class="shell">
    <div class="section-head" data-reveal>
      <span class="eyebrow">
        <span class="dot"></span>
        {sc.eyebrow}
      </span>
      <h2>
        {sc.titleLead} <span class="highlight">{sc.titleHighlight}</span>{' '}
        {sc.titleTrail}
      </h2>
      <p class="section-intro">{sc.intro}</p>
    </div>
    <ul class="schedule-list">
      {rows.map((row) => (
        <li class="schedule-row" data-reveal>
          <span class="schedule-days">{row.days}</span>
          <span class="schedule-time">{row.time}</span>
          <span class="schedule-mode">{row.mode}</span>
          <span
            class:list={[
              'schedule-status',
              row.open ? 'is-open' : 'is-limited',
            ]}
          >
            {row.status}
          </span>
        </li>
      ))}
    </ul>
    <p class="schedule-note" data-reveal>
      {sc.note}
    </p>
  </div>
</section>

<style>
  .schedule-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-card);
    box-shadow: var(--shadow-card);
  }
  .schedule-row {
    display: grid;
    grid-template-columns: 1fr 1.3fr 1.6fr auto;
    align-items: center;
    gap: var(--space-md);
    padding: 1.1rem 1.4rem;
  }
  .schedule-row + .schedule-row {
    border-block-start: var(--border-width) solid var(--color-border);
  }
  .schedule-days {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .schedule-time {
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-medium);
  }
  .schedule-mode {
    color: var(--color-muted);
    font-size: var(--font-size-small);
  }
  .schedule-status {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-pill);
    border: var(--border-width) solid var(--color-border);
  }
  .schedule-status.is-open {
    background: var(--color-accent-soft);
    color: var(--color-text);
    border-color: transparent;
  }
  .schedule-status.is-limited {
    color: var(--color-muted);
  }
  .schedule-note {
    margin: var(--space-md) 0 0;
    font-size: var(--font-size-small);
    color: var(--color-muted);
  }
  @media (max-width: 720px) {
    .schedule-row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'days status'
        'time status'
        'mode mode';
      gap: 0.35rem var(--space-md);
    }
    .schedule-days {
      grid-area: days;
    }
    .schedule-time {
      grid-area: time;
    }
    .schedule-mode {
      grid-area: mode;
    }
    .schedule-status {
      grid-area: status;
      align-self: start;
    }
  }
</style>
