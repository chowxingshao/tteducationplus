---
import { getSiteConfig } from '../../lib/config/site.ts';
import { getUi } from '../../lib/i18n/ui.ts';
interface Props {
  locale: string;
}
const { locale } = Astro.props;
const site = getSiteConfig();
const ui = await getUi(locale);
const hero = ui.home.hero;
const whatsapp = site.social.whatsapp;
const instagram = site.social.instagram;
const grades = [
  { subject: hero.reportSubject1, from: 'C', to: 'A', width: '88%' },
  { subject: hero.reportSubject2, from: 'C', to: 'A−', width: '80%' },
  { subject: hero.reportSubject3, from: 'B', to: 'A+', width: '92%' },
];
---

<section class="hero" id="top">
  <div class="shell hero-grid">
    <div class="hero-copy" data-reveal data-reveal-stagger="0.06">
      <p class="eyebrow" data-reveal>
        <span class="dot"></span>
        {hero.eyebrow} · {hero.since}
      </p>
      <h1 class="hero-title" data-reveal>
        {hero.titleLead} <span class="highlight">{hero.titleHighlight}</span>{' '}
        {hero.titleTrail}
      </h1>
      <p class="hero-lede" data-reveal>
        {hero.lede}
      </p>
      <div class="cta-row" data-reveal>
        {whatsapp && (
          <a
            class="btn btn-primary"
            href={whatsapp}
            target="_blank"
            rel="noopener"
          >
            {hero.ctaWhatsapp}
            <span class="btn-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          </a>
        )}
        {instagram && (
          <a
            class="btn btn-ghost"
            href={instagram}
            target="_blank"
            rel="noopener"
          >
            {hero.ctaInstagram}
          </a>
        )}
      </div>
      <div class="trust-row" data-reveal>
        <span class="trust-item">
          <span class="stars" aria-hidden="true">
            ★★★★★
          </span>{' '}
          {hero.trustRating}
        </span>
        <span class="trust-sep" aria-hidden="true"></span>
        <span class="trust-item">{hero.trustYears}</span>
        <span class="trust-sep" aria-hidden="true"></span>
        <span class="trust-item">{hero.trustLangs}</span>
      </div>
    </div>

    <div class="hero-panel" data-reveal data-reveal-delay="0.12">
      <div class="panel">
        <div class="chips" aria-hidden="true">
          <span class="chip">
            <span class="chip-dot"></span>
            {hero.chip1}
          </span>
          <span class="chip">
            <span class="chip-dot"></span>
            {hero.chip2}
          </span>
        </div>
        <div class="report-shell">
          <div class="report">
            <div class="report-head">
              <span class="report-who">
                <span class="report-avatar" aria-hidden="true">
                  T<span class="avatar-plus">t</span>
                </span>
                <span>
                  <small>{hero.reportLabel}</small>
                  <strong>{hero.reportStudent}</strong>
                </span>
              </span>
              <span class="report-tag">{hero.reportTerm}</span>
            </div>
            <ul class="grades">
              {grades.map((grade) => (
                <li class="grade">
                  <span class="grade-sub">{grade.subject}</span>
                  <span class="grade-bar">
                    <i style={`--w: ${grade.width}`} />
                  </span>
                  <span class="grade-move">
                    <span class="from">{grade.from}</span>
                    <span class="arrow" aria-hidden="true">
                      →
                    </span>
                    <span class="to">{grade.to}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="float-note">
          <span class="note-key">{hero.reportNoteKey}</span>
          {hero.reportNote}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 6vw, 5.5rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }
  .hero-title {
    font-size: var(--font-size-title);
    line-height: var(--line-title);
    margin: 0;
  }
  .hero-lede {
    margin: 0;
    font-size: var(--font-size-lead);
    color: var(--color-muted);
    max-inline-size: 34ch;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .trust-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.2rem;
    color: var(--color-muted);
    font-size: var(--font-size-small);
  }
  .stars {
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }
  .trust-sep {
    inline-size: 1px;
    block-size: 0.95rem;
    background: var(--color-border);
  }

  /* panel */
  .panel {
    position: relative;
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 1.9rem);
    background:
      linear-gradient(0deg, var(--color-grid) 1px, transparent 1px) 0 0 / 100%
        26px,
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px) 0 0 / 26px
        100%,
      var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    box-shadow: var(--shadow-lift);
    min-block-size: 20rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .chips {
    position: absolute;
    inset-inline-end: -0.5rem;
    inset-block-start: -1rem;
    display: flex;
    gap: 0.5rem;
  }
  .chip {
    background: var(--color-card);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.5rem 0.85rem;
    font-size: 0.8rem;
    font-weight: var(--weight-heading);
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .chip-dot {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .report-shell {
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.45rem;
  }
  .report {
    background: var(--color-card);
    border-radius: calc(var(--radius-md) - 0.4rem);
    padding: 1.2rem 1.2rem 1.1rem;
    box-shadow: var(--shadow-card);
  }
  .report-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .report-who {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .report-avatar {
    inline-size: 2.1rem;
    block-size: 2.1rem;
    border-radius: 50%;
    background: var(--color-ink-surface);
    color: var(--color-on-ink);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: 0.85rem;
  }
  .avatar-plus {
    color: var(--color-accent);
  }
  .report-who small {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .report-who strong {
    font-size: 0.85rem;
    font-weight: var(--weight-heading);
  }
  .report-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--color-accent-soft);
    color: var(--color-text);
    padding: 0.3rem 0.55rem;
    border-radius: 0.45rem;
  }
  .grades {
    margin: 0.95rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .grade {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .grade-sub {
    flex: 1;
    font-size: 0.85rem;
    font-weight: var(--weight-medium);
  }
  .grade-bar {
    flex: none;
    inline-size: 5.5rem;
    block-size: 0.45rem;
    border-radius: 0.25rem;
    background: var(--color-border);
    overflow: hidden;
  }
  .grade-bar i {
    display: block;
    block-size: 100%;
    inline-size: var(--w, 60%);
    border-radius: 0.25rem;
    background: var(--color-accent);
    transform-origin: left;
  }
  .grade-move {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    inline-size: 3.4rem;
    justify-content: flex-end;
  }
  .grade-move .from,
  .grade-move .arrow {
    color: var(--color-muted);
  }
  .grade-move .to {
    background: var(--color-accent);
    color: var(--color-on-accent);
    padding: 0.05rem 0.35rem;
    border-radius: 0.3rem;
  }
  .float-note {
    position: absolute;
    inset-inline-start: -0.8rem;
    inset-block-end: -1.1rem;
    background: var(--color-ink-surface);
    color: var(--color-on-ink);
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.95rem;
    box-shadow: var(--shadow-lift);
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    max-inline-size: 16rem;
  }
  .note-key {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    flex: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .grade-bar i {
      animation: grade-grow 1.1s 0.3s var(--ease) both;
    }
  }
  @keyframes grade-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 920px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .chips {
      inset-inline-end: 0.5rem;
    }
    .float-note {
      inset-inline-start: 0.5rem;
    }
  }
  @media (max-width: 460px) {
    .chips,
    .float-note {
      position: static;
      max-inline-size: none;
      margin-block: 0;
    }
    .chips {
      margin-block-end: 0.75rem;
    }
    .panel {
      gap: 1rem;
    }
  }
</style>
