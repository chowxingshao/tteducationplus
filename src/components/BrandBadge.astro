---
// Faithful rebuild of the TT Education+ badge as inline SVG: a yellow ring on a
// near-black field with a periodic-table-style "Tt" symbol and the 2014 atomic
// number. Scales crisply and stays legible in dark mode (ring + white symbol).
// The full "Teacher Thomas / IN PROGRESS" lockup only reads at large sizes, so
// it shows from `variant="full"` (used large); the compact mark is the default.
interface Props {
  size?: number;
  variant?: 'mark' | 'full';
  class?: string;
}
const { size = 42, variant = 'mark', class: className } = Astro.props;
const full = variant === 'full';
---

<span
  class:list={['brand-badge', { 'is-full': full }, className]}
  style={`--badge-size: ${size}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 48 48" role="img" focusable="false">
    <circle
      cx="24"
      cy="24"
      r="22"
      fill="var(--badge-field, #16171b)"
      stroke="#ffcc00"
      stroke-width="3"
    ></circle>
    <!-- atomic number: 20 over 14 -->
    <text class="badge-year" x="14.5" y="18">
      20
    </text>
    <text class="badge-year" x="14.5" y="25.5">
      14
    </text>
    <!-- element symbol -->
    <text class="badge-symbol" x="26" y="31">
      Tt
    </text>
    {full && (
      <>
        <text class="badge-name" x="24" y="38.5">
          Teacher Thomas
        </text>
        <text class="badge-sub" x="24" y="43">
          IN PROGRESS
        </text>
      </>
    )}
  </svg>
</span>

<style>
  .brand-badge {
    inline-size: var(--badge-size);
    block-size: var(--badge-size);
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }
  .brand-badge svg {
    inline-size: 100%;
    block-size: 100%;
    display: block;
  }
  .badge-symbol {
    fill: #ffffff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 21px;
    text-anchor: middle;
    letter-spacing: -0.5px;
  }
  .badge-year {
    fill: #ffffff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 6.4px;
    text-anchor: middle;
    letter-spacing: 0.3px;
  }
  .badge-name,
  .badge-sub {
    fill: #ffffff;
    text-anchor: middle;
    font-family: var(--font-display);
    font-weight: 700;
  }
  .badge-name {
    font-size: 4.6px;
    letter-spacing: 0.1px;
  }
  .badge-sub {
    font-size: 2.7px;
    letter-spacing: 1.1px;
    fill: #ffcc00;
  }
  /* In the full lockup, lift the symbol so the name/subtitle fit beneath it. */
  .is-full .badge-symbol {
    font-size: 17px;
  }
</style>
