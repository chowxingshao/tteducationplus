---
import BrandBadge from './BrandBadge.astro';
import { getSiteConfig } from '../lib/config/site.ts';
import { getUi } from '../lib/i18n/ui.ts';
import { getRouteManifest } from '../lib/routing/manifest.ts';
interface Props {
  locale: string;
}
const { locale } = Astro.props;
const site = getSiteConfig();
const ui = await getUi(locale);
const routes = (await getRouteManifest()).filter(
  (route) => route.locale === locale,
);
const home = routes.find(
  (route) => route.kind === 'page' && route.slug === 'home',
);
const homePath = home?.path ?? '/';
const anchor = (id: string) => `${homePath}#${id}`;
const links = [
  { href: anchor('subjects'), label: ui.nav.subjects },
  { href: anchor('approach'), label: ui.nav.approach },
  { href: anchor('schedule'), label: ui.nav.schedule },
  { href: anchor('gallery'), label: ui.nav.gallery },
  { href: anchor('faq'), label: ui.nav.faq },
];
const year = new Date().getFullYear();
const whatsapp = site.social.whatsapp;
const instagram = site.social.instagram;
---

<footer class="site-footer">
  <div class="shell site-footer-inner">
    <div class="footer-brand">
      <a class="brand" href={homePath}>
        <BrandBadge size={38} />
        <span class="brand-name">{site.name}</span>
      </a>
      <p class="footer-tagline">{ui.home.footer.tagline}</p>
    </div>
    <nav class="footer-nav" aria-label={ui.accessibility.footerNavigation}>
      <p class="footer-heading">{ui.home.footer.navHeading}</p>
      <ul class="nav-list">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="footer-contact">
      <p class="footer-heading">{ui.nav.contact}</p>
      <ul class="contact-list">
        {whatsapp && (
          <li>
            <a href={whatsapp} target="_blank" rel="noopener">
              {ui.home.contact.whatsappLabel}
            </a>
          </li>
        )}
        {instagram && (
          <li>
            <a href={instagram} target="_blank" rel="noopener">
              {ui.home.contact.instagramLabel}
            </a>
          </li>
        )}
      </ul>
    </div>
  </div>
  <div class="shell footer-base">
    <p>
      &copy; {year} {site.name}. {ui.home.footer.rights}
    </p>
    <p class="footer-note">{ui.home.footer.disclaimer}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: var(--font-size-small);
  }
  .site-footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-xl) var(--space-lg);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-text);
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: 1.05rem;
  }
  .footer-tagline {
    margin-block: var(--space-sm) 0;
    max-inline-size: 28ch;
  }
  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-block: 0 var(--space-sm);
  }
  .nav-list,
  .contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-nav a,
  .footer-contact a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .footer-nav a:hover,
  .footer-contact a:hover {
    color: var(--color-text);
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    padding-block: var(--space-md) var(--space-lg);
    border-block-start: var(--border-width) solid var(--color-border);
  }
  .footer-base p {
    margin: 0;
  }
  .footer-note {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 760px) {
    .site-footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
